# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://art_rium:changeme@localhost:5432/art_rium

# ── ComfyUI ───────────────────────────────────────────────────────────────────
COMFYUI_HOST=127.0.0.1:8188
COMFYUI_OUTPUT_DIR=E:/00_comfy/output
# Route the Wan 2.2 experts' attention through SageAttention (INT8 QK / FP8 PV)
# instead of PyTorch SDPA. ~3x on the attention itself, at a relative error of
# ~0.04 against exact attention. Scoped to the two Wan builders only; every
# other model here was calibrated without it. Requires `sageattention` in
# ComfyUI's venv plus KJNodes. Set false to fall back to SDPA.
WAN_SAGE_ATTENTION=true

# ── Storage (managed ingested files) ─────────────────────────────────────────
# Defaults to ./storage — override if you want files elsewhere
# STORAGE_DIR=D:/art-rium-storage

# ── Auth ──────────────────────────────────────────────────────────────────────
API_KEY=your-generated-key-here

# ── WordPress ─────────────────────────────────────────────────────────────────
WP_BASE_URL=xxx
WP_USERNAME=xxx
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Polylang default language code — used as ?lang= when uploading media
WP_DEFAULT_LANGUAGE=en

# ── Ollama (local VLM for image analysis at upload time) ─────────────────────
OLLAMA_HOST=http://localhost:11434
# Must be vision-capable. Default qwen2.5vl:7b is fast and accurate enough
# for alt-text + SEO copy. Heavier alternatives: qwen2.5vl:32b, qwen3-vl
OLLAMA_VLM_MODEL=qwen2.5vl:latest
# Source images are downscaled to this edge before being sent to the VLM
# (the full 1080px JPG still goes to WordPress)
VLM_ANALYSIS_MAX_EDGE=512

# ── Public URL (needed for Instagram to fetch images) ─────────────────────────
# PUBLIC_BASE_URL=https://xyz.trycloudflare.com

# ── Instagram (optional) ──────────────────────────────────────────────────────
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
IMAGE_SHARE_TOKEN=
# Start new posts with Meta's "AI info" self-disclosure (is_ai_generated) on.
# Per-post overridable in the tool; existing posts keep whatever they were saved with.
INSTAGRAM_AI_LABEL_DEFAULT=true

# ── YouTube (optional — used by the Articles tool to embed videos) ───────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# (Desktop app). After filling client_id/secret, run:
#     python scripts/youtube_auth.py
# which opens a browser, captures consent, and writes YOUTUBE_REFRESH_TOKEN
# back into this file.
#
# IMPORTANT: set the OAuth consent screen to "In production" (NOT "Testing")
# in Google Cloud Console, otherwise the refresh token expires after 7 days.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_DEFAULT=public

# ── MiniMax H3 cloud video (optional — /tools/video-api/) ────────────────────
# This one costs real money: MiniMax bills per second of generated video.
# The tool refuses to run without a key, and refuses to exceed the monthly
# limit even with one. Key: platform.minimax.io → API Keys.
MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io
#
# Budget defaults for a brand-new month. Once a month exists, its limit,
# warning threshold and exchange rate are edited in the tool itself and carry
# forward — these values are only the starting point.
# VIDEO_API_DEFAULT_LIMIT_EUR=20.00
# VIDEO_API_WARN_THRESHOLD_PCT=80
# VIDEO_API_USD_EUR_RATE=1.08
# Applied to reservations only, never to the displayed price: it covers rate
# drift and rounding between reserving and being billed.
# VIDEO_API_SAFETY_FACTOR=1.10
# MiniMax allows 2 concurrent tasks on pay-as-you-go; more just fails.
# VIDEO_API_MAX_CONCURRENT=2
